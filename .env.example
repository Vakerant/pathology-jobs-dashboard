# Pathology Career Intelligence Platform — environment configuration.
# Copy to `.env` and fill in what you need. `.env` is gitignored — NEVER commit it.

# ---- Database / paths ----
# DB_PATH=/absolute/path/to/data.db
# BACKUP_DIR=/absolute/path/to/backups

# ---- Crawler / scraper ----
# CRAWLER_USER_AGENT=...
# SCRAPE_CONNECT_TIMEOUT=10
# SCRAPE_READ_TIMEOUT=30
# MAX_WORKERS=10
# MAX_ITEMS_PER_SOURCE=60
# AUTO_SCRAPE_HOURS=6
# PATHO_INSECURE_HOSTS=host1.example,host2.example   # broken-cert hosts only

# ---- Retention ----
# PRUNE_UNSEEN_DAYS=45
# STALE_NOTICE_DAYS=45

# ---- Email alerts (Gmail App Password recommended) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SENDER=your-sender@gmail.com
# SMTP_APP_PASSWORD=abcd efgh ijkl mnop       # 16-char Gmail App Password
# ALERT_RECIPIENTS=you@gmail.com,partner@gmail.com

# ---- Admin / security ----
# ADMIN_SECRET=change-me-to-a-long-random-value   # unset => /admin disabled

# ---- LLM extraction (DeepSeek by default; any OpenAI-compatible provider) ----
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_ENABLED=false

# ---- Server ----
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
